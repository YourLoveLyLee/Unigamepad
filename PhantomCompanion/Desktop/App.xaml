<Application x:Class="PhantomCompanion.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <Color x:Key="BgNearBlack">#090A0C</Color>
        <Color x:Key="SurfaceGraphite">#12141A</Color>
        <Color x:Key="SurfaceElevated">#181B22</Color>
        <Color x:Key="SurfaceBorder">#252932</Color>
        <Color x:Key="AccentCrimson">#C81E32</Color>
        <Color x:Key="AccentGold">#D4A853</Color>
        <Color x:Key="TextPrimary">#F0F2F5</Color>
        <Color x:Key="TextSecondary">#9AA1AE</Color>
        <Color x:Key="StatusOk">#34D399</Color>
        <Color x:Key="StatusWarn">#F59E0B</Color>

        <SolidColorBrush x:Key="BgNearBlackBrush" Color="{StaticResource BgNearBlack}" />
        <SolidColorBrush x:Key="SurfaceGraphiteBrush" Color="{StaticResource SurfaceGraphite}" />
        <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="{StaticResource SurfaceElevated}" />
        <SolidColorBrush x:Key="SurfaceBorderBrush" Color="{StaticResource SurfaceBorder}" />
        <SolidColorBrush x:Key="AccentCrimsonBrush" Color="{StaticResource AccentCrimson}" />
        <SolidColorBrush x:Key="AccentGoldBrush" Color="{StaticResource AccentGold}" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimary}" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}" />
        <SolidColorBrush x:Key="StatusOkBrush" Color="{StaticResource StatusOk}" />
        <SolidColorBrush x:Key="StatusWarnBrush" Color="{StaticResource StatusWarn}" />

        <Style TargetType="Button" x:Key="PhantomButton">
            <Setter Property="Background" Value="{StaticResource SurfaceElevatedBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource SurfaceBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource AccentGoldBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#222631" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="PhantomCrimsonButton" BasedOn="{StaticResource PhantomButton}">
            <Setter Property="Background" Value="#2D1016" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentCrimsonBrush}" />
            <Setter Property="Foreground" Value="#F9FAFB" />
        </Style>

        <Style TargetType="TextBox" x:Key="PhantomTextBox">
            <Setter Property="Background" Value="#0E1015" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="CaretBrush" Value="{StaticResource AccentGoldBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource SurfaceBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style TargetType="ComboBox" x:Key="PhantomComboBox">
            <Setter Property="Background" Value="#14171E" />
            <Setter Property="Foreground" Value="#F0F2F5" />
            <Setter Property="BorderBrush" Value="{StaticResource SurfaceBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style TargetType="CheckBox" x:Key="PhantomCheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </Application.Resources>
</Application>
